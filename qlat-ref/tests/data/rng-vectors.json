{
 "metadata": {
  "description": "C++ qlat RngState test vectors for qlat_ref.rng (SHA-256 counter mode)",
  "provenance": {
   "qlat_version": "1.21",
   "qlat_utils_version": "1.21",
   "generator": "qlat-ref/tests/data/make-rng-vectors.py (run under result-py-local/bin/setenv-qlat.sh)",
   "python": "3.13.18",
   "numpy": "2.4.4",
   "platform": "Linux-6.18.65-x86_64-with-glibc2.42",
   "machine": "x86_64",
   "libc": [
    "glibc",
    "2.42"
   ],
   "git_commit": "7d56bc7152d043b61b42f7a8e49712cfb2ed5a6e",
   "note": "Every value was cross-checked against qlat_ref.rng before being written, so a mismatch between the two implementations aborts this script instead of committing a wrong expectation."
  },
  "exactness": {
   "integer": "bit-exact uint64; the tests compare Python ints with ==",
   "float": "values_hex is the bit pattern produced by the x86-64 glibc build; the tests compare hex exactly on x86-64 Linux and fall back to 1e-13 relative tolerance elsewhere"
  },
  "split_semantics": "split(key) formats '[index] {key}' (or '[type,index] {key}') padded with ASCII spaces to a multiple of 64 bytes, feeds it to the raw SHA-256 compression function without final padding, and advances numBytes by the padded byte count",
  "python_api_notes": {
   "split_accepts_int_in_qlat_python": false,
   "split_int_note": "split() accepts only str/bytes in BOTH packages (it routes through as_bytes), so an int raises TypeError; C++ has split(Long) == split(show(Long)), and the int spelling lives on the constructor: RngState(rs, 7) == rs.split('7').  qlat_ref.rng no longer accepts an int in split() (it used to, as a documented extension, and that was removed for parity).",
   "ctor_bytes_note": "FIXED: RngState.__init__ uses as_seed_bytes, so a bytes seed is used VERBATIM (b'abc' == 'abc') instead of going through repr(); labels also carry embedded NULs verbatim",
   "no_newtype_in_python": true,
   "state_export_in_python": "RngState.get_state()/set_state() + __reduce__ expose the 104-byte state (magic b'QLATRNG' + version 1 + 24 LE uint32 in exportRngState order)"
  },
  "maintenance_note": "These vectors are a committed reference, not a snapshot to regenerate casually: the tests compare them exactly, so a mismatch means the implementation changed.  Regenerate only if the C++ algorithm changes.",
  "algorithm": "SHA-256 counter mode over a fixed chaining value: rand_gen hashes '[index]' continuing the SHA-256 prefix with a byte counter, returns the last two 32-bit words as one big-endian uint64, and caches the first three words LIFO"
 },
